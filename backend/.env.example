# Copy this file to .env and adjust as needed.

# Where the vector store built by notebooks/rag_pipeline.ipynb lives.
# Default resolves to backend/data/vector_store relative to this file.
VECTOR_STORE_DIR=./data/vector_store
COLLECTION_NAME=automotive_docs
TOP_K=4

# Local Ollama server used for answer generation.
# Install: https://ollama.com  |  Pull a model with: ollama pull llama3.2
OLLAMA_HOST=http://localhost:11434
LLM_MODEL_NAME=llama3.2:1b

# Extended Track: fine-tuned YOLO weights for dashboard warning-light detection.
YOLO_WEIGHTS_PATH=../data/models/dash_yolo_best.pt
YOLO_CONFIDENCE_THRESHOLD=0.5

# CORS: the frontend's origin.
FRONTEND_ORIGIN=http://127.0.0.1:7860